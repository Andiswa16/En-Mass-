<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - En Massé Logistics</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="logo">
                <img src="~/images/logo.png" alt="En Massé Logo">
                    <span style="font-size: 1.2rem; font-weight: bold; color: var(--text-light);">En Massé Logistics</span>
                </div>
            <div class="nav-links">
                <a href="@Url.Action("Index", "Home")">Home</a>
                <a href="@Url.Action("About", "Home")">About us</a>
                <a href="#">Services</a>
                <a href="#" class="active">Register/Login</a>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>
</body>
</html>