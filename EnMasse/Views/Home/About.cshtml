@{
    ViewData["Title"] = "About Us";
}

<section class="content-section">
    <div class="text-content">
        <h2>ABOUT<span>US</span></h2>
        <p>En Massé is a South African road logistics company providing reliable and efficient freight transportation services to businesses across provincial and national routes. We specialize in managing fleet operations, coordinating drivers, and ensuring safe, timely delivery of goods between business locations.</p>
        <p>Through our En Massé Road Logistics Management System (ERLMS), we streamline transport operations, improve visibility, and enhance decision-making using a secure, centralized enterprise platform. Our mission is to deliver logistics solutions that are efficient, transparent, and built for business growth.</p>
    </div>
    <div class="image-grid">
        <img src="~/images/workers.jpg" style="height: 250px;">
            <img src="~/images/delivery driver.webp" style="height: 250px;">
            </div>
        </section>

