@model List<EnMasse.Models.Delivery>
@{
    ViewData["Title"] = "Deliveries";
    Layout = "_AdminLayout";
}

<style>
    .page-container { padding: 28px; }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #2a2a2a;
    }

    .page-title   { font-size: 22px; font-weight: 700; color: #fff; }
    .page-subtitle { font-size: 13px; color: #888; margin-top: 2px; }

    .filter-bar {
        display: flex;
        gap: 8px;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .filter-select {
        padding: 10px 16px;
        border-radius: 25px;
        border: 1.5px solid #333;
        background: #222;
        color: #fff;
        font-size: 14px;
        outline: none;
        cursor: pointer;
        font-family: 'Segoe UI', sans-serif;
    }

    .filter-select:focus { border-color: #f24e29; }

    .deliveries-table {
        width: 100%;
        background: #222;
        border-collapse: collapse;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #2a2a2a;
    }

    .deliveries-table thead { background: #1a1a1a; }

    .deliveries-table th {
        color: #777;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        padding: 12px 14px;
        text-align: left;
        border-bottom: 1px solid #2a2a2a;
    }

    .deliveries-table td {
        padding: 13px 14px;
        font-size: 13px;
        color: #ccc;
        border-bottom: 1px solid #1e1e1e;
        vertical-align: middle;
    }

    .deliveries-table tr:last-child td { border-bottom: none; }
    .deliveries-table tr:hover td { background: #1f1f1f; }

    .status-badge {
        display: inline-block;
        padding: 3px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-pending    { background: #2a2a2a; color: #aaa; }
    .status-intransit  { background: #332200; color: #f59e0b; }
    .status-delivered  { background: #0d2e1a; color: #10b981; }

    .action-form { display: flex; gap: 6px; align-items: center; }

    .status-select {
        padding: 5px 10px;
        border-radius: 6px;
        border: 1px solid #333;
        background: #1a1a1a;
        color: #fff;
        font-size: 12px;
        cursor: pointer;
        outline: none;
        font-family: 'Segoe UI', sans-serif;
    }

    .status-select:focus { border-color: #f24e29; }

    .alert-success {
        background: #0d2e1a;
        color: #10b981;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        border: 1px solid #10b981;
        font-size: 14px;
    }

    .empty-state { text-align: center; padding: 40px; color: #666; }
</style>

<div class="page-container">

    <div class="page-header">
        <div>
            <div class="page-title">Deliveries</div>
            <div class="page-subtitle">@Model.Count total @(Model.Count == 1 ? "delivery" : "deliveries")</div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">✓ @TempData["Success"]</div>
    }

    {{!-- Filter bar --}}
    <form method="get" asp-action="Deliveries" asp-controller="Admin" class="filter-bar">
        <input type="text" name="searchString" class="search-box"
               placeholder="Search by client name..."
               value="@ViewBag.SearchString" />

        <select name="statusFilter" class="filter-select"
                onchange="this.form.submit()">
            <option value="">All Statuses</option>
            <option value="Pending"    selected="@(ViewBag.StatusFilter == "Pending"    ? "selected" : null)">Pending</option>
            <option value="In Transit" selected="@(ViewBag.StatusFilter == "In Transit" ? "selected" : null)">In Transit</option>
            <option value="Delivered"  selected="@(ViewBag.StatusFilter == "Delivered"  ? "selected" : null)">Delivered</option>
        </select>

        <button type="submit" class="btn-primary" style="padding:10px 20px; font-size:14px; border-radius:25px;">
            Filter
        </button>

        @if (!string.IsNullOrEmpty(ViewBag.SearchString as string) || !string.IsNullOrEmpty(ViewBag.StatusFilter as string))
        {
            <a href="@Url.Action("Deliveries", "Admin")" class="btn-secondary"
               style="padding:10px 20px; font-size:14px; border-radius:25px;">
                Clear
            </a>
        }
    </form>

    <table class="deliveries-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Client</th>
                <th>Route</th>
                <th>Weight</th>
                <th>Date</th>
                <th>Status</th>
                <th>Update</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                var statusClass = d.Status switch {
                    "In Transit" => "status-intransit",
                    "Delivered"  => "status-delivered",
                    _            => "status-pending"
                };
                <tr>
                    <td style="font-weight:700; color:#fff; font-family:monospace;">#DR@d.DeliveryID</td>
                    <td>@(d.User?.Username ?? "—")</td>
                    <td style="font-size:12px;">@d.PickupAddress → @d.DeliveryAddress</td>
                    <td>@d.Weight</td>
                    <td style="color:#888; font-size:12px;">@d.DeliveryDate.ToString("d MMM yy")</td>
                    <td><span class="status-badge @statusClass">@d.Status</span></td>
                    <td>
                        {{!-- FIX: Update button uses consistent .btn-update class --}}
                        <form method="post" asp-action="UpdateStatus" asp-controller="Admin" class="action-form">
                            <input type="hidden" name="id" value="@d.DeliveryID" />
                            <select name="status" class="status-select">
                                <option value="Pending"    selected="@(d.Status == "Pending"    ? "selected" : null)">Pending</option>
                                <option value="In Transit" selected="@(d.Status == "In Transit" ? "selected" : null)">In Transit</option>
                                <option value="Delivered"  selected="@(d.Status == "Delivered"  ? "selected" : null)">Delivered</option>
                            </select>
                            <button type="submit" class="btn-update">Save</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="empty-state">No deliveries found.</td>
                </tr>
            }
        </tbody>
    </table>

</div>
