@model List<EnMasse.Models.User>
@{
    ViewData["Title"] = "Manage Clients";
    Layout = "_AdminLayout";
}

<style>
    /* ── PAGE ── */
    .page-container {
        padding: 28px;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #2a2a2a;
    }

    .page-title {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
    }

    .page-subtitle {
        font-size: 13px;
        color: #888;
        margin-top: 2px;
    }

    /* ── SEARCH BAR ── */
    .search-form {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
    }

    /* ── TABLE ── */
    .clients-table {
        width: 100%;
        background: #222;
        border-collapse: collapse;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #2a2a2a;
    }

        .clients-table thead {
            background: #1a1a1a;
        }

        .clients-table th {
            color: #777;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            padding: 12px 16px;
            text-align: left;
            border-bottom: 1px solid #2a2a2a;
        }

        .clients-table td {
            padding: 14px 16px;
            font-size: 13px;
            color: #ccc;
            border-bottom: 1px solid #1e1e1e;
            vertical-align: middle;
        }

        .clients-table tr:last-child td {
            border-bottom: none;
        }

        .clients-table tr:hover td {
            background: #1f1f1f;
        }

    /* ── ROLE BADGE ── */
    .role-badge {
        display: inline-block;
        padding: 3px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        background: #1a3a2a;
        color: #10b981;
    }

    /* ── EMPTY STATE ── */
    .empty-state {
        text-align: center;
        padding: 40px;
        color: #666;
    }

    /* ── ALERTS ── */
    .alert-success {
        background: #0d2e1a;
        color: #10b981;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
        border: 1px solid #10b981;
    }

    .alert-error {
        background: #2e0d0d;
        color: #f87171;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
        border: 1px solid #f87171;
    }
</style>

<div class="page-container">

    <div class="page-header">
        <div>
            <div class="page-title">Manage Clients</div>
            <div class="page-subtitle">@Model.Count registered client @(Model.Count == 1 ? "company" : "companies")</div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">✓ @TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-error">✗ @TempData["Error"]</div>
    }

    {{!-- Search --}}
    <form method="get" asp-action="Clients" asp-controller="Admin" class="search-form">
        <input type="text" name="searchString" class="search-box"
               placeholder="Search clients by name..."
               value="@ViewBag.SearchString" />
        <button type="submit" class="btn-primary" style="padding:10px 20px; font-size:14px; border-radius:25px;">
            Search
        </button>
        @if (!string.IsNullOrEmpty(ViewBag.SearchString as string))
        {
            <a href="@Url.Action("Clients", "Admin")" class="btn-secondary"
                   style="padding:10px 20px; font-size:14px; border-radius:25px;">
                Clear
            </a>
        }
    </form>

    <table class="clients-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Company / Username</th>
                <th>Role</th>
                <th>User ID</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td style="color:#666; font-size:12px;">@user.UserID</td>
                    <td style="font-weight:600; color:#fff;">@user.Username</td>
                    <td><span class="role-badge">@user.Role</span></td>
                    <td style="color:#666; font-family:monospace;">#@user.UserID</td>
                    <td>
                        {{!-- FIX: .btn-danger now has proper styling (cursor, radius, hover) --}}
                        <form method="post" action="/Admin/DeleteClient"
                              onsubmit="return confirm('Are you sure you want to remove @user.Username? This cannot be undone.');">
                            <input type="hidden" name="id" value="@user.UserID" />
                            <button type="submit" class="btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="empty-state">
                        No clients registered yet.
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
