@model EnMasse.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body, .admin-body {
        background: #161616;
        color: #fff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* ── TOP BAR ── */
    .top-bar {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 18px 28px;
        background: #1a1a1a;
        border-bottom: 1px solid #2a2a2a;
    }

    .date-badge {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border: 2px solid #f24e29;
        border-radius: 50%;
        font-size: 22px;
        font-weight: 700;
        line-height: 1;
        color: #fff;
        flex-shrink: 0;
    }

    .date-badge span {
        font-size: 10px;
        color: #aaa;
        font-weight: 400;
    }

    .search-wrap {
        flex: 1;
        max-width: 520px;
        position: relative;
    }

    .search-wrap input {
        width: 100%;
        padding: 12px 20px 12px 48px;
        border-radius: 30px;
        border: 2px solid #333;
        background: #222;
        color: #fff;
        font-size: 14px;
        outline: none;
        transition: border-color .2s;
    }

    .search-wrap input:focus { border-color: #f24e29; }

    .search-wrap .icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #888;
        font-size: 16px;
    }

    .top-bar-right { margin-left: auto; }

    .user-pill {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #222;
        border: 1px solid #333;
        border-radius: 30px;
        padding: 8px 18px 8px 10px;
        font-size: 14px;
        font-weight: 600;
    }

    .user-pill .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #444;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    /* ── STAT CARDS ── */
    .stat-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        padding: 20px 28px 0;
    }

    .stat-card {
        background: #222;
        border-radius: 14px;
        padding: 16px 20px;
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .stat-icon {
        font-size: 22px;
        margin-top: 2px;
        flex-shrink: 0;
    }

    .stat-icon.warn { color: #f59e0b; }
    .stat-icon.ok   { color: #10b981; }
    .stat-icon.pin  { color: #f24e29; }
    .stat-icon.cal  { color: #60a5fa; }

    .stat-num {
        font-size: 28px;
        font-weight: 800;
        line-height: 1;
        color: #fff;
    }

    .stat-label { font-size: 12px; color: #aaa; margin-top: 4px; }
    .stat-delta { font-size: 11px; margin-top: 6px; color: #10b981; }
    .stat-delta.neg { color: #ef4444; }

    /* ── MAIN GRID ── */
    .main-grid {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 16px;
        padding: 16px 28px;
    }

    .left-col { display: flex; flex-direction: column; gap: 16px; }
    .right-col { display: flex; flex-direction: column; gap: 16px; }

    /* ── PANEL ── */
    .panel {
        background: #222;
        border-radius: 14px;
        padding: 20px 22px;
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .panel-title {
        font-size: 15px;
        font-weight: 700;
        color: #fff;
    }

    .panel-menu { color: #666; cursor: pointer; font-size: 18px; }

    /* ── VEHICLES OVERVIEW ── */
    .vehicle-bar-labels {
        display: grid;
        grid-template-columns: 120px 1fr 1fr 1fr 1fr;
        font-size: 11px;
        color: #aaa;
        margin-bottom: 8px;
    }

    .vehicle-bar-row {
        display: grid;
        grid-template-columns: 120px 1fr 1fr 1fr 1fr;
        align-items: center;
        gap: 3px;
        margin-bottom: 4px;
    }

    .vbar-label { font-size: 12px; color: #aaa; }

    .bar-group {
        display: flex;
        height: 24px;
        border-radius: 4px;
        overflow: hidden;
        gap: 2px;
        grid-column: 2 / 6;
    }

    .bar-seg {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 600;
        color: #fff;
        border-radius: 3px;
    }

    .bar-seg.onway   { background: #7c3aed; }
    .bar-seg.unload  { background: #f24e29; }
    .bar-seg.loading { background: #3b82f6; }
    .bar-seg.waiting { background: #6b7280; }

    /* detail rows */
    .detail-rows { margin-top: 14px; }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 7px 0;
        border-bottom: 1px solid #2a2a2a;
        font-size: 13px;
        color: #ccc;
    }

    .detail-row:last-child { border-bottom: none; }
    .detail-row .icon-label { display: flex; align-items: center; gap: 8px; color: #aaa; }
    .detail-row .time { color: #888; font-size: 12px; }
    .detail-row .pct  { color: #fff; font-weight: 600; font-size: 12px; }

    /* ── DELIVERY PERFORMANCE ── */
    .perf-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 9px 0;
        border-bottom: 1px solid #2a2a2a;
        font-size: 13px;
    }

    .perf-row:last-child { border-bottom: none; }

    .perf-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #2a2a2a;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .perf-label { flex: 1; color: #ccc; }
    .perf-sub   { font-size: 11px; color: #10b981; }
    .perf-sub.neg { color: #ef4444; }
    .perf-val   { font-weight: 700; font-size: 14px; }

    /* ── DONUT CHART ── */
    .donut-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 10px 0;
    }

    .donut-svg { width: 140px; height: 140px; }

    .donut-center {
        font-size: 22px;
        font-weight: 800;
        fill: #fff;
    }

    .donut-sub {
        font-size: 11px;
        fill: #aaa;
    }

    /* ── FLEET TABLE ── */
    .fleet-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .fleet-table th {
        text-align: left;
        color: #aaa;
        font-size: 11px;
        font-weight: 600;
        padding: 6px 8px;
        border-bottom: 1px solid #2a2a2a;
    }

    .fleet-table th:last-child { text-align: right; }

    .fleet-table td {
        padding: 10px 8px;
        color: #ddd;
        border-bottom: 1px solid #2a2a2a;
    }

    .fleet-table td:last-child {
        text-align: right;
        font-weight: 800;
        font-size: 15px;
        color: #fff;
    }

    .fleet-table tr:last-child td { border-bottom: none; }

    /* ── CLIENT LIST ── */
    .client-row {
        padding: 11px 0;
        border-bottom: 1px solid #2a2a2a;
        font-size: 14px;
        color: #ccc;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .client-row:last-child { border-bottom: none; }

    .client-dot {
        width: 8px;
        height: 8px;
        background: #f24e29;
        border-radius: 50%;
        flex-shrink: 0;
    }

    /* ── DELIVERIES TABLE ── */
    .del-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .del-table th {
        text-align: left;
        color: #888;
        font-size: 11px;
        padding: 8px 10px;
        border-bottom: 1px solid #2a2a2a;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .del-table td {
        padding: 10px 10px;
        color: #ccc;
        border-bottom: 1px solid #1e1e1e;
        vertical-align: middle;
    }

    .del-table tr:last-child td { border-bottom: none; }

    .badge {
        display: inline-block;
        padding: 3px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .badge-pending  { background: #3b3210; color: #fbbf24; }
    .badge-transit  { background: #1e3a5f; color: #60a5fa; }
    .badge-delivered{ background: #052e16; color: #34d399; }

    select.status-select {
        background: #333;
        color: #fff;
        border: 1px solid #444;
        border-radius: 6px;
        padding: 4px 8px;
        font-size: 12px;
        cursor: pointer;
    }

    .btn-update {
        background: #f24e29;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        cursor: pointer;
        margin-left: 6px;
    }

    .btn-update:hover { background: #d43e1e; }
</style>

<!-- ══════════════════════════════════════
     TOP BAR
══════════════════════════════════════ -->
<div class="top-bar">
    @{
        var today = DateTime.Now;
    }
    <div class="date-badge">
        @today.Day
        <span>@today.ToString("ddd")<br />@today.ToString("MMM")</span>
    </div>

    <div class="search-wrap">
        <span class="icon">🔍</span>
        <form method="get" asp-action="Dashboard" style="display:contents;">
            <input name="searchString" placeholder="Search for an item" />
        </form>
    </div>

    <div class="top-bar-right">
        <div class="user-pill">
            <div class="avatar">👤</div>
            @Model.AdminName
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════
     STAT CARDS
══════════════════════════════════════ -->
<div class="stat-row">
    <div class="stat-card">
        <div class="stat-icon ok">🚛</div>
        <div>
            <div class="stat-num">@Model.InTransitDeliveries</div>
            <div class="stat-label">On route vehicles</div>
            <div class="stat-delta">+18.2% than last week</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon warn">⚠️</div>
        <div>
            <div class="stat-num">@Model.PendingDeliveries</div>
            <div class="stat-label">Pending deliveries</div>
            <div class="stat-delta neg">-6.5% than last week</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon pin">📍</div>
        <div>
            <div class="stat-num">@Model.TotalClients</div>
            <div class="stat-label">Total clients</div>
            <div class="stat-delta">+4.2% than last week</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon cal">✅</div>
        <div>
            <div class="stat-num">@Model.CompletedDeliveries</div>
            <div class="stat-label">Completed deliveries</div>
            <div class="stat-delta">+13.2% than last week</div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════
     MAIN GRID
══════════════════════════════════════ -->
<div class="main-grid">

    <!-- LEFT COLUMN -->
    <div class="left-col">

        <!-- Vehicles Overview -->
        <div class="panel">
            <div class="panel-header">
                <span class="panel-title">Vehicles overview</span>
                <span class="panel-menu">⋮</span>
            </div>

            <div class="vehicle-bar-labels">
                <span></span>
                <span>On the way</span>
                <span>Unloading</span>
                <span>Loading</span>
                <span>Waiting</span>
            </div>

            <div class="vehicle-bar-row">
                <span class="vbar-label">All vehicles</span>
                <div class="bar-group">
                    <div class="bar-seg onway"   style="flex:39.7">39.7%</div>
                    <div class="bar-seg unload"  style="flex:28.3">28.3%</div>
                    <div class="bar-seg loading" style="flex:17.4">17.4%</div>
                    <div class="bar-seg waiting" style="flex:14.6">14.6%</div>
                </div>
            </div>

            <div class="detail-rows">
                <div class="detail-row">
                    <span class="icon-label">🚛 On the way</span>
                    <span class="time">2hr 10min</span>
                    <span class="pct">39.7%</span>
                </div>
                <div class="detail-row">
                    <span class="icon-label">📦 Unloading</span>
                    <span class="time">3hr 15min</span>
                    <span class="pct">28.3%</span>
                </div>
                <div class="detail-row">
                    <span class="icon-label">🔄 Loading</span>
                    <span class="time">1hr 24min</span>
                    <span class="pct">17.4%</span>
                </div>
                <div class="detail-row">
                    <span class="icon-label">⏱️ Waiting</span>
                    <span class="time">5hr 19min</span>
                    <span class="pct">14.6%</span>
                </div>
            </div>
        </div>

        <!-- Delivery Performance + Donut side-by-side -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">

            <div class="panel">
                <div class="panel-header">
                    <div>
                        <div class="panel-title">Delivery Performance</div>
                        <div style="font-size:11px; color:#10b981; margin-top:2px;">12% increase this month</div>
                    </div>
                    <span class="panel-menu">⋮</span>
                </div>

                <div class="perf-row">
                    <div class="perf-icon">📦</div>
                    <div class="perf-label">
                        Packages in transit
                        <div class="perf-sub">▲ 25.8%</div>
                    </div>
                    <div class="perf-val">@(Model.InTransitDeliveries > 0 ? Model.InTransitDeliveries + "k" : "–")</div>
                </div>

                <div class="perf-row">
                    <div class="perf-icon">🚚</div>
                    <div class="perf-label">
                        Packages out for delivery
                        <div class="perf-sub">▲ 4.3%</div>
                    </div>
                    <div class="perf-val">5k</div>
                </div>

                <div class="perf-row">
                    <div class="perf-icon">✅</div>
                    <div class="perf-label">
                        Packages delivered
                        <div class="perf-sub neg">▼ 12.5</div>
                    </div>
                    <div class="perf-val">@(Model.CompletedDeliveries > 0 ? Model.CompletedDeliveries + "k" : "–")</div>
                </div>

                <div class="perf-row">
                    <div class="perf-icon">📈</div>
                    <div class="perf-label">
                        Delivery success rate
                        <div class="perf-sub">▲ 35.6%</div>
                    </div>
                    <div class="perf-val">95%</div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title">Reasons for delivery exceptions</span>
                    <span class="panel-menu">⋮</span>
                </div>
                <div class="donut-wrap">
                    <svg class="donut-svg" viewBox="0 0 36 36">
                        <!-- background ring -->
                        <circle cx="18" cy="18" r="15.9" fill="none" stroke="#2a2a2a" stroke-width="3.8"/>
                        <!-- green arc ~70% -->
                        <circle cx="18" cy="18" r="15.9" fill="none"
                                stroke="#10b981" stroke-width="3.8"
                                stroke-dasharray="70 30"
                                stroke-dashoffset="25"
                                stroke-linecap="round"/>
                        <!-- orange arc ~30% -->
                        <circle cx="18" cy="18" r="15.9" fill="none"
                                stroke="#f24e29" stroke-width="3.8"
                                stroke-dasharray="30 70"
                                stroke-dashoffset="-45"
                                stroke-linecap="round"/>
                        <text x="18" y="16.5" text-anchor="middle" class="donut-center" font-size="6" fill="#fff" font-weight="800">30%</text>
                        <text x="18" y="21" text-anchor="middle" class="donut-sub" font-size="2.5" fill="#aaa">AVG. Exceptions</text>
                    </svg>
                </div>
            </div>

        </div>

        <!-- All Deliveries Table -->
        <div class="panel">
            <div class="panel-header">
                <span class="panel-title">All Deliveries</span>
            </div>
            <table class="del-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Client</th>
                        <th>Route</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.AllDeliveries)
                    {
                        var badgeClass = d.Status switch {
                            "Delivered"  => "badge-delivered",
                            "In Transit" => "badge-transit",
                            _            => "badge-pending"
                        };
                        <tr>
                            <td>#@d.DeliveryID</td>
                            <td>@d.User?.Username</td>
                            <td style="font-size:12px; color:#888;">@d.PickupAddress → @d.DeliveryAddress</td>
                            <td><span class="badge @badgeClass">@d.Status</span></td>
                            <td>
                                <form method="post" asp-action="UpdateStatus" style="display:flex; align-items:center; gap:4px;">
                                    <input type="hidden" name="id" value="@d.DeliveryID" />
                                    <select name="status" class="status-select">
                                        <option>Pending</option>
                                        <option>In Transit</option>
                                        <option>Delivered</option>
                                    </select>
                                    <button class="btn-update">Update</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div><!-- /left-col -->

    <!-- RIGHT COLUMN -->
    <div class="right-col">

        <!-- Fleet Management -->
        <div class="panel">
            <div class="panel-header">
                <span class="panel-title">Fleet Management</span>
                <span style="font-size:12px; color:#aaa; font-weight:600;">Total Trips</span>
            </div>
            <table class="fleet-table">
                <thead>
                    <tr>
                        <th>Vehicle</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var trips = new[] { 102, 158, 261, 151, 421 };
                        for (int i = 0; i < Model.FleetVehicles.Count; i++)
                        {
                            <tr>
                                <td>@Model.FleetVehicles[i]</td>
                                <td>@(i < trips.Length ? trips[i] : 0)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Client Management -->
        <div class="panel">
            <div class="panel-header">
                <span class="panel-title">Client Management</span>
            </div>
            @foreach (var name in Model.ClientNames)
            {
                <div class="client-row">
                    <div class="client-dot"></div>
                    @name
                </div>
            }
            @if (!Model.ClientNames.Any())
            {
                <div style="color:#555; font-size:13px; padding:10px 0;">No clients yet.</div>
            }
        </div>

    </div><!-- /right-col -->

</div>
