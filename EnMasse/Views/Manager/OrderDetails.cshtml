@model EnMasse.Models.Delivery
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Assign Driver - En Massé</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background: #161616; color: white; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
        .card { background: #222; padding: 40px; border-radius: 15px; width: 450px; border: 1px solid #333; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
        h2 { color: #f24e29; margin-top: 0; }
        .info-box { background: #1a1a1a; padding: 15px; border-radius: 8px; margin-bottom: 20px; border-left: 4px solid #f24e29; }
        .label { color: #888; font-size: 12px; text-transform: uppercase; }
        .value { font-size: 16px; margin-bottom: 10px; display: block; }
        select { width: 100%; padding: 12px; background: #333; color: white; border: 1px solid #444; border-radius: 5px; margin-bottom: 20px; outline: none; }
        .btn-assign { background: #f24e29; color: white; width: 100%; padding: 14px; border: none; border-radius: 5px; font-weight: bold; cursor: pointer; font-size: 16px; }
        .btn-assign:hover { background: #ff6b47; }
        .back-link { display: block; text-align: center; margin-top: 20px; color: #888; text-decoration: none; font-size: 14px; }
    </style>
</head>
<body>
    <div class="card">
        <h2>Review Request #@Model.DeliveryID</h2>
        <div class="info-box">
            <span class="label">Client Name</span>
            <span class="value">@Model.User?.Username</span>
            
            <span class="label">Delivery Destination</span>
            <span class="value">@Model.DeliveryAddress</span>

            <span class="label">Current Status</span>
            <span class="value" style="color:#f59e0b">@Model.Status</span>
        </div>

        <form asp-action="AssignDriver" method="post">
            <input type="hidden" name="deliveryId" value="@Model.DeliveryID" />
            
            <label class="label">Select Available Driver</label>
            <select name="driverId" required>
                <option value="">-- Choose Personnel --</option>
                @foreach (var driver in ViewBag.Drivers)
                {
                    <option value="@driver.UserID">@driver.Username (Driver ID: @driver.UserID)</option>
                }
            </select>

            <button type="submit" class="btn-assign">Approve & Assign Driver</button>
        </form>

        <a href="@Url.Action("Dashboard")" class="back-link">← Return to Dashboard</a>
    </div>
</body>
</html>