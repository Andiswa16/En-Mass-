@model EnMasse.Models.DashboardViewModel
@{
    ViewData["Title"] = "Manager Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manager Dashboard – En Massé Logistics</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #161616;
            color: #fff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            min-height: 100vh;
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 220px;
            background: #111;
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
            z-index: 100;
            border-right: 1px solid #1e1e1e;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 20px 16px;
            border-bottom: 1px solid #1e1e1e;
        }

        .sidebar-logo img { height: 35px; }
        .sidebar-logo span { color: white; font-size: 1rem; font-weight: 700; }

        .sidebar-section {
            padding: 6px 20px;
            color: #555;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 10px;
        }

        /* FIX: corrected nav-item styles — were only inline previously */
        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 20px;
            color: #888;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: all 0.2s;
        }

        .nav-item:hover,
        .nav-item.active {
            color: white;
            border-left-color: #f24e29;
            background-color: #1a1a1a;
            text-decoration: none;
        }

        .nav-item .nav-icon { color: #e05a2b; font-size: 15px; width: 18px; text-align: center; }

        /* Disabled nav items */
        .nav-item.disabled {
            opacity: 0.35;
            pointer-events: none;
        }

        .nav-bottom { margin-top: auto; border-top: 1px solid #1e1e1e; padding: 8px 0; }
        .nav-item.logout { color: #f24e29; }
        .nav-item.logout:hover { background: #1a1010; color: #ff6b47; }

        /* ── MAIN CONTENT ── */
        .main-content {
            margin-left: 220px;
            flex: 1;
            padding: 30px;
            background: #161616;
            overflow-y: auto;
        }

        /* ── TOP BAR ── */
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            gap: 16px;
            flex-wrap: wrap;
        }

        .search-form {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .search-bar {
            padding: 10px 20px;
            border-radius: 25px;
            border: 1.5px solid #333;
            background: #222;
            color: #fff;
            width: 340px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
            font-family: 'Segoe UI', sans-serif;
        }

        .search-bar:focus { border-color: #f24e29; }

        .search-btn {
            padding: 10px 20px;
            border-radius: 25px;
            border: none;
            background: #333;
            color: white;
            cursor: pointer;
            font-size: 14px;
            transition: background 0.2s;
        }

        .search-btn:hover { background: #444; }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: bold;
            color: #fff;
            background: #222;
            border: 1px solid #333;
            border-radius: 30px;
            padding: 8px 18px 8px 12px;
        }

        .user-profile .role-label {
            font-size: 11px;
            color: #888;
            font-weight: 400;
        }

        /* ── STATS GRID ── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: #222;
            padding: 20px 24px;
            border-radius: 14px;
            display: flex;
            align-items: flex-start;
            gap: 16px;
            border: 1px solid #2a2a2a;
        }

        .stat-icon { font-size: 24px; margin-top: 2px; }
        .stat-num { font-size: 2.2rem; font-weight: 800; color: #fff; line-height: 1; }
        .stat-label { font-size: 12px; color: #888; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.5px; }

        /* ── CONTENT GRID ── */
        .content-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
        }

        .panel {
            background: #222;
            padding: 22px;
            border-radius: 14px;
            border: 1px solid #2a2a2a;
        }

        .panel h2 {
            font-size: 15px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 16px;
        }

        /* ── TABLE ── */
        table { width: 100%; border-collapse: collapse; }

        th {
            color: #777;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 8px 10px;
            border-bottom: 1px solid #2a2a2a;
            text-align: left;
        }

        td {
            padding: 12px 10px;
            font-size: 13px;
            border-bottom: 1px solid #1e1e1e;
            color: #ccc;
        }

        tr:last-child td { border-bottom: none; }

        .status-badge {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .status-pending    { background: #2a2a2a; color: #aaa; }
        .status-intransit  { background: #332200; color: #f59e0b; }
        .status-delivered  { background: #0d2e1a; color: #10b981; }

        .view-details-link {
            color: #f24e29;
            font-weight: 600;
            text-decoration: none;
            font-size: 13px;
        }

        .view-details-link:hover { text-decoration: underline; color: #ff6b47; }

        /* Map placeholder */
        .map-placeholder {
            background: #1a1a1a;
            height: 280px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px dashed #333;
            color: #666;
            font-weight: 600;
            font-size: 14px;
            text-align: center;
        }

        /* Success/error messages */
        .alert-success {
            background: #0d2e1a;
            color: #10b981;
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
            border: 1px solid #10b981;
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-logo">
            <img src="~/images/logo.png" alt="En Massé" />
            <span>En Massé</span>
        </div>

        <div class="sidebar-section">Menu</div>

        <a href="@Url.Action("Index", "Home")" class="nav-item">
            <span class="nav-icon">←</span> Return to Home
        </a>
        <a href="@Url.Action("Dashboard", "Manager")" class="nav-item active">
            <span class="nav-icon">📊</span> Dashboard
        </a>

        {{!-- FIX: were all href="#" — now wired to real actions --}}
        <a href="@Url.Action("CreateTrip", "Manager")" class="nav-item">
            <span class="nav-icon">➕</span> Create Trip
        </a>

        {{!-- These are admin-only pages; disabled for manager --}}
        <a href="#" class="nav-item disabled" title="Admin only">
            <span class="nav-icon">📋</span> All Deliveries
        </a>
        <a href="#" class="nav-item disabled" title="Coming soon">
            <span class="nav-icon">📈</span> Reports
        </a>
        <a href="#" class="nav-item disabled" title="Coming soon">
            <span class="nav-icon">🎫</span> Open Tickets
        </a>

        <div class="nav-bottom">
            <a href="#" class="nav-item disabled" title="Coming soon">
                <span class="nav-icon">❓</span> Help
            </a>
            <a href="#" class="nav-item disabled" title="Coming soon">
                <span class="nav-icon">⚙️</span> Settings
            </a>
            <a href="@Url.Action("Logout", "Auth")" class="nav-item logout">
                <span class="nav-icon">➤</span> Log out
            </a>
        </div>
    </div>

    <div class="main-content">

        @if (TempData["Success"] != null)
        {
            <div class="alert-success">@TempData["Success"]</div>
        }

        <div class="top-bar">
            <a href="@Url.Action("CreateTrip", "Manager")" class="btn-primary" style="text-decoration:none;">
                + Create New Trip
            </a>

            <form asp-controller="Manager" asp-action="Dashboard" method="get" class="search-form">
                <input type="text" name="searchString" class="search-bar"
                       placeholder="Search by client or delivery ID..."
                       value="@ViewBag.SearchString" />
                <button type="submit" class="search-btn">Search</button>
            </form>

            <div class="user-profile">
                <span style="font-size:20px;">👤</span>
                <div>
                    <div>@Model.ManagerName</div>
                    <div class="role-label">Logistics Manager</div>
                </div>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">🚛</div>
                <div>
                    <div class="stat-num">@Model.ActiveDrivers</div>
                    <div class="stat-label">Active Drivers</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="color:#f59e0b">🕒</div>
                <div>
                    <div class="stat-num">@Model.PendingRequests</div>
                    <div class="stat-label">Pending Requests</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="color:#f24e29">📦</div>
                <div>
                    <div class="stat-num">@Model.InTransit</div>
                    <div class="stat-label">In Transit</div>
                </div>
            </div>
        </div>

        <div class="content-grid">
            <div class="panel">
                <h2>Recent Orders</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Req ID</th>
                            <th>Client</th>
                            <th>Destination</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            var statusClass = order.Status switch {
                                "In Transit" => "status-intransit",
                                "Delivered"  => "status-delivered",
                                _            => "status-pending"
                            };
                            <tr>
                                <td>#@order.ReqId</td>
                                <td>@order.Client</td>
                                <td>@order.Destination</td>
                                <td><span class="status-badge @statusClass">@order.Status</span></td>
                                <td>
                                    <a href="@Url.Action("OrderDetails", "Manager", new { id = order.ReqId })"
                                       class="view-details-link">View Details →</a>
                                </td>
                            </tr>
                        }
                        @if (!Model.RecentOrders.Any())
                        {
                            <tr>
                                <td colspan="5" style="text-align:center; color:#666; padding:20px;">
                                    No orders yet. <a href="@Url.Action("CreateTrip", "Manager")" style="color:#f24e29;">Create the first trip →</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="panel">
                <h2>Live Fleet View</h2>
                <div class="map-placeholder">
                    🗺️<br />Map Integration<br />Coming Soon
                </div>
            </div>
        </div>

    </div>

</body>
</html>
