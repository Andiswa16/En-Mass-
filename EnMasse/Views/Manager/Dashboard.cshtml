@model EnMasse.Models.DashboardViewModel
@{
    // This tells MVC NOT to use your public _Layout.cshtml with the top navbar
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Manager Dashboard - En Massé</title>
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        /* Scoped styles just for the dashboard */
        body { margin: 0; display: flex; height: 100vh; background-color: #e0e0e0; font-family: sans-serif; color: #000; }
        
        /* Sidebar */
        .sidebar { width: 250px; background-color: #0a0a0a; color: white; padding: 20px 0; display: flex; flex-direction: column; }
        .sidebar-logo { color: #f24e29; font-size: 2rem; padding: 0 20px; margin-bottom: 30px; font-weight: bold; }
        .nav-item { padding: 15px 20px; color: #b3b3b3; text-decoration: none; display: block; }
        .nav-item:hover, .nav-item.active { color: white; border-left: 3px solid #f24e29; background-color: #1a1a1a; }
        .nav-bottom { margin-top: auto; }

        /* Main Content */
        .main-content { flex: 1; padding: 30px; overflow-y: auto; }
        
        /* Top Bar */
        .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; }
        .search-bar { padding: 10px 20px; border-radius: 25px; border: 1px solid #ccc; width: 400px; }
        .user-profile { display: flex; align-items: center; gap: 10px; font-weight: bold; }
        
        /* Action Button */
        .btn-primary { background-color: #f24e29; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; margin-bottom: 20px;}

        /* Stats Grid */
        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: white; padding: 20px; border-radius: 15px; text-align: center; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .stat-card h3 { margin: 0 0 10px 0; font-size: 1rem; color: #555; }
        .stat-card .number { font-size: 2.5rem; font-weight: bold; margin: 0; }

        /* Bottom Grid (Table + Map) */
        .content-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; }
        .panel { background: white; padding: 20px; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 15px; text-align: left; border-bottom: 1px solid #eee; }
        th { color: #555; }
        .status-delayed { font-weight: bold; color: #d9534f; }
        .status-delivered { font-weight: bold; color: #5cb85c; }
        .status-intransit { font-weight: bold; color: #f0ad4e; }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-logo" style="display: flex; align-items: center; gap: 10px;">
            <img src="~/images/logo.png" alt="En Massé" style="height: 35px;">
            <span style="color: white; font-size: 1.5rem;">En Massé</span>
        </div>

        <div style="padding: 0 20px; color: #555; font-size: 0.8rem; margin-bottom: 10px;">Menu</div>
        
        <a href="@Url.Action("Index", "Home")" class="nav-item" style="color: #f24e29;">← Return to Home</a>
        <a href="@Url.Action("Dashboard", "Manager")" class="nav-item active">Dashboard</a>
        
        <a href="#" class="nav-item">Request Delivery</a>
        <a href="#" class="nav-item">Delivery Status</a>
        <a href="#" class="nav-item">Report</a>
        <a href="#" class="nav-item">Open Tickets</a>
        
        <div class="nav-bottom">
            <a href="#" class="nav-item">Help</a>
            <a href="#" class="nav-item">Settings</a>
            <a href="@Url.Action("Logout", "Auth")" class="nav-item">Log out</a>
        </div>
    </div>

    <div class="main-content">
        <div class="top-bar">
            <a href="@Url.Action("CreateTrip", "Manager")" class="btn-primary" style="text-decoration: none; display: inline-block;">+ Create New Trip</a>
            
            <form asp-controller="Manager" asp-action="Dashboard" method="get" style="display: flex; margin: 0;">
                <input type="text" name="searchString" class="search-bar" placeholder="Search for a delivery...">
                <button type="submit" style="margin-left: 10px; padding: 10px 20px; border-radius: 25px; border: none; background: #333; color: white; cursor: pointer;">Search</button>
            </form>

            <div class="user-profile">
                <span>👤</span>
                <div>
                    <div>@Model.ManagerName</div>
                    <div style="font-size: 0.8rem; color: #555;">Logistics Manager</div>
                </div>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <h3>🚚 ACTIVE DRIVERS</h3>
                <p class="number">@Model.ActiveDrivers</p>
            </div>
            <div class="stat-card">
                <h3>🕒 PENDING REQUESTS</h3>
                <p class="number">@Model.PendingRequests</p>
            </div>
            <div class="stat-card">
                <h3>📦 IN TRANSIT</h3>
                <p class="number">@Model.InTransit</p>
            </div>
        </div>

        <div class="content-grid">
            <div class="panel">
                <h2>Recent Orders</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Req ID</th>
                            <th>Client</th>
                            <th>Destination</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var order in Model.RecentOrders)
                        {
                            <tr>
                                <td>@order.ReqId</td>
                                <td>@order.Client</td>
                                <td>@order.Destination</td>
                                <td class="status-@(order.Status.ToLower().Replace(" ", ""))">@order.Status</td>
                                <td>
                                    <a href="@Url.Action("OrderDetails", "Manager", new { id = order.ReqId })" style="color: black; font-weight: bold; text-decoration: underline;">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="panel">
                <h2>LIVE FLEET VIEW</h2>
                <div style="background-color: #eee; height: 300px; border-radius: 10px; display: flex; align-items: center; justify-content: center; border: 2px dashed #ccc; color: #777; font-weight: bold;">
                    Map Integration Goes Here
                </div>
            </div>
        </div>
    </div>

</body>
</html>