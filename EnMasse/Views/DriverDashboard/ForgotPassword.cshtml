@model EnMasse.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Reset Password – En Massé Logistics</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --orange: #E8571A;
            --orange-dark: #c94a12;
            --dark: #141414;
            --panel-dark: #1a1a1a;
            --text-light: #ffffff;
            --text-muted: #aaaaaa;
        }

        html, body {
            height: 100%;
            font-family: 'Poppins', sans-serif;
            background: var(--dark);
            color: var(--text-light);
        }

        .wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* LEFT PANEL */

        .left {
            flex: 1;
            position: relative;
            background: linear-gradient(135deg,#111 0%,#2a2a2a 60%,#444 100%);
            display: flex;
            flex-direction: column;
            padding: 2.5rem 3rem;
        }

            .left::before {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: var(--orange);
            }

        .brand {
            display: flex;
            align-items: center;
            gap: .6rem;
            margin-bottom: auto;
        }

        .brand-icon {
            width: 36px;
            height: 36px;
        }

        .brand-name {
            font-weight: 700;
            font-size: 1rem;
        }

        .hero-text {
            margin-top: auto;
            padding-bottom: 4rem;
        }

        .hero-title {
            font-family: 'Poppins', sans-serif;
            font-weight: 900;
            font-size: clamp(3rem,6vw,5rem);
            line-height: 1;
            text-transform: uppercase;
        }

            .hero-title .accent {
                color: var(--orange);
            }

        .hero-subtitle {
            margin-top: .75rem;
            font-size: .95rem;
            color: var(--text-muted);
        }

        /* DIVIDER */

        .divider {
            width: 1px;
            background: linear-gradient(to bottom,transparent 5%,#333 30%,#333 70%,transparent 95%);
        }

        /* RIGHT PANEL */

        .right {
            width: 420px;
            background: var(--panel-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 2.5rem;
        }

        /* CARD */

        .login-box {
            width: 100%;
            max-width: 360px;
            background: rgba(255,255,255,0.02);
            padding: 2.5rem;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.05);
            animation: fadeUp .5s ease both;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .login-heading {
            font-family: 'Poppins', sans-serif;
            font-weight: 800;
            font-size: 2rem;
            text-align: center;
            margin-bottom: .4rem;
        }

        .login-sub {
            text-align: center;
            font-size: .9rem;
            color: var(--text-muted);
            margin-bottom: 2rem;
        }

        /* INPUTS */

        .field {
            margin-bottom: 1.4rem;
        }

            .field input {
                width: 100%;
                background: #222;
                border: 1px solid #333;
                border-radius: 8px;
                padding: .9rem 1rem;
                font-size: .95rem;
                color: #fff;
                outline: none;
            }

                .field input:focus {
                    border-color: var(--orange);
                    box-shadow: 0 0 0 2px rgba(232,87,26,.25);
                    background: #1e1e1e;
                }

        /* BUTTON */

        .btn-login {
            width: 100%;
            background: var(--orange);
            border: none;
            border-radius: 8px;
            padding: .85rem;
            font-weight: 600;
            font-size: .95rem;
            color: white;
            cursor: pointer;
            transition: .25s;
        }

            .btn-login:hover {
                background: var(--orange-dark);
                transform: translateY(-1px);
                box-shadow: 0 8px 18px rgba(232,87,26,.25);
            }

        /* MESSAGES */

        .message {
            margin-top: 1rem;
            text-align: center;
            font-size: .85rem;
            color: var(--orange);
        }

        .error {
            margin-top: 1rem;
            text-align: center;
            font-size: .85rem;
            color: var(--orange);
        }

        /* LINK */

        .back {
            display: block;
            text-align: center;
            margin-top: 1rem;
            font-size: .85rem;
            color: var(--text-muted);
            text-decoration: none;
        }

            .back:hover {
                color: var(--orange);
            }

    </style>
</head>

<body>

    <div class="wrapper">

        <div class="left">

            <div class="brand">
                <svg class="brand-icon" viewBox="0 0 36 36">
                    <path d="M18 3L33 10.5V25.5L18 33L3 25.5V10.5L18 3Z" fill="#E8571A" />
                </svg>
                <span class="brand-name">En Massé Logistics</span>
            </div>

            <div class="hero-text">

                <div class="hero-title">
                    RESET <span class="accent">PASSWORD</span>
                </div>

                <p class="hero-subtitle">
                    Enter your username and set a new password
                </p>

            </div>

        </div>

        <div class="divider"></div>

        <div class="right">

            <div class="login-box">

                <h2 class="login-heading">Reset Password</h2>

                <p class="login-sub">Enter your details below</p>

                <form asp-action="ForgotPassword" method="post">

                    <div class="field">
                        <input asp-for="DUsername" placeholder="Username" />
                    </div>

                    <div class="field">
                        <input asp-for="NewPassword" type="password" placeholder="New Password" />
                    </div>

                    <div class="field">
                        <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" />
                    </div>

                    <button class="btn-login">Reset Password</button>

                </form>

                @if (ViewBag.Message != null)
                {
                    <div class="message">@ViewBag.Message</div>

                    <a class="back" asp-action="Login" asp-controller="DriverDashboard">
                        Return to Login
                    </a>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="error">Please check your information.</div>
                }

            </div>

        </div>

    </div>

</body>
</html>