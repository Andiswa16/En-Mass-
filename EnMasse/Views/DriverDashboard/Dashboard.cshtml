@model List<EnMasse.Models.Delivery>
@{
    Layout = null;
    var driverName = Context.Session.GetString("Username") ?? "Jane Doe";
}

<!DOCTYPE html>
<html>
<head>
    <title>Driver Dashboard | En Massé</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root { --orange: #f24e29; --sidebar-bg: #1a1a1a; --center-bg: #e5e5e5; }
        body { font-family: 'Poppins', sans-serif; margin: 0; display: flex; height: 100vh; overflow: hidden; }

        /* Sidebar (Left) */
        .sidebar { width: 240px; background: var(--sidebar-bg); color: white; padding: 30px 20px; display: flex; flex-direction: column; }
        .sidebar h2 { font-size: 1.2rem; margin-bottom: 40px; }
        .nav-item { color: #888; text-decoration: none; padding: 12px 10px; display: block; font-size: 14px; transition: 0.3s; }
        .nav-item:hover, .nav-item.active { color: white; }
        .nav-item.active { border-left: 3px solid var(--orange); background: #222; }
        .sidebar-footer { margin-top: auto; border-top: 1px solid #333; padding-top: 20px; }

        /* Delivery List (Center) */
        .delivery-pane { width: 420px; background: var(--center-bg); padding: 25px; overflow-y: auto; }
        .date-header { display: flex; align-items: center; gap: 15px; margin-bottom: 25px; }
        .date-circle { width: 45px; height: 45px; border: 1.5px solid #333; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; }

        .delivery-card { background: white; border-radius: 20px; padding: 20px; margin-bottom: 20px; position: relative; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .delivery-card.in-transit { background: #a39b94; color: white; }
        .status-badge { position: absolute; top: 15px; right: 15px; background: rgba(0,0,0,0.1); padding: 4px 12px; border-radius: 15px; font-size: 11px; font-weight: 600; }

        /* Timeline Styling */
        .timeline { margin: 20px 0; padding-left: 30px; position: relative; border-left: 2px dashed #ccc; margin-left: 10px; }
        .delivery-card.in-transit .timeline { border-left-color: white; }
        .timeline-item { position: relative; margin-bottom: 15px; font-size: 13px; }
        .timeline-item::before { content: ''; position: absolute; left: -36px; top: 4px; width: 10px; height: 10px; background: currentColor; border-radius: 50%; }

        /* Info & Map (Right) */
        .info-pane { flex: 1; background: white; padding: 30px; overflow-y: auto; }
        .top-nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
        .search-container { background: #f1f1f1; border-radius: 25px; padding: 8px 20px; width: 60%; display: flex; align-items: center; }
        .search-container input { border: none; background: transparent; outline: none; width: 100%; margin-left: 10px; }

        .map-container { width: 100%; height: 300px; background: #eee; border-radius: 25px; margin-bottom: 30px; overflow: hidden; }
        
        /* Vehicle Tabs */
        .tabs { display: flex; border-bottom: 1px solid #eee; margin-bottom: 20px; }
        .tab { padding: 10px 20px; color: #999; cursor: pointer; position: relative; }
        .tab.active { color: black; font-weight: 600; }
        .tab.active::after { content: ''; position: absolute; bottom: -1px; left: 0; width: 100%; height: 3px; background: var(--orange); }

        .vehicle-details { display: grid; grid-template-columns: 150px 1fr; gap: 30px; align-items: center; }
        .load-indicator { background: #e8f0fe; border-radius: 15px; padding: 20px; text-align: center; }
        .load-indicator .fill { background: #4285f4; color: white; border-radius: 5px; padding: 2px 0; font-size: 10px; width: 71%; margin: 0 auto; }
    </style>
</head>
<body>

    <div class="sidebar">
        <h2>Driver Dashboard</h2>
        <a asp-action="Dashboard" class="nav-item active">🚚 Delivery Status</a>
        <a asp-action="Report" class="nav-item">📊 Delivery Report</a>
        
        <div class="sidebar-footer">
            <a href="#" class="nav-item">❓ Help</a>
            <a href="#" class="nav-item">⚙ Settings</a>
            <a asp-action="Logout" class="nav-item" style="color: var(--orange);">↪ Log out</a>
        </div>
    </div>

    <div class="content-wrapper" style="display: flex; flex: 1;">
        <!-- Center Panel -->
        <div class="delivery-pane">
            <div class="date-header">
                <div class="date-circle">@DateTime.Now.Day</div>
                <div>@DateTime.Now.ToString("ddd")<br>@DateTime.Now.ToString("MMMM")</div>
            </div>

            @foreach (var item in Model)
            {
                <div class="delivery-card @(item.Status == "In Transit" ? "in-transit" : "")">
                    <span class="status-badge">@item.Status</span>
                    <strong>Delivery ID: #DR@item.DeliveryID</strong>
                    
                    <div class="timeline">
                        <div class="timeline-item">@item.CreatedDate.ToShortDateString() — Checking</div>
                        <div class="timeline-item">@DateTime.Now.ToShortDateString() — @item.Status</div>
                        <div class="timeline-item" style="opacity: 0.5;">--/--/-- — Pending</div>
                    </div>

                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="deliveryId" value="@item.DeliveryID" />
                        <select name="status" onchange="this.form.submit()" style="width:100%; background:rgba(255,255,255,0.2); border:1px solid rgba(255,255,255,0.5); border-radius:5px; color:inherit; padding:5px;">
                            <option value="">Update Status...</option>
                            <option value="In Transit">In Transit</option>
                            <option value="Delivered">Delivered</option>
                        </select>
                    </form>
                </div>
            }
        </div>

        <!-- Right Panel -->
        <div class="info-pane">
            <div class="top-nav">
                <div class="search-container">
                    <span>🔍</span><input type="text" placeholder="Search for a delivery">
                </div>
                <div style="display:flex; align-items:center; gap:10px;">
                    <strong>@driverName</strong>
                    <div style="width:40px; height:40px; background:#ddd; border-radius:50%;"></div>
                </div>
            </div>

            <div class="map-container" id="map">
                <div style="text-align:center; padding-top:120px; color:#999;">Google Maps API Active</div>
            </div>

            <h3>Main Info</h3>
            <div class="tabs">
                <div class="tab">Driver Information</div>
                <div class="tab active">Vehicle</div>
                <div class="tab">Customer Information</div>
            </div>

            <div class="vehicle-details">
                <div class="load-indicator">
                    <div class="fill">71%</div>
                    <p style="font-size:12px; margin-top:10px;">Capacity</p>
                </div>
                <div>
                    <h4 style="margin:0;">Mercedes-Benz Actros 1845</h4>
                    <p style="color:#666; font-size:14px; margin: 10px 0;">
                        Weight: 40050kg<br>
                        Load Volume: 770 Cu Ft<br>
                        Rating: 4.9 ⭐
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Google Maps API -->
    <script src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&callback=initMap" async defer></script>
    <script>
        function initMap() {
            const map = new google.maps.Map(document.getElementById("map"), {
                zoom: 10,
                center: { lat: -26.2041, lng: 28.0473 },
                styles: [{ "featureType": "all", "elementType": "all", "stylers": [{ "saturation": -100 }] }]
            });
        }
    </script>
</body>
</html>