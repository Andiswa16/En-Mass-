@{
    ViewData["Title"] = "Driver Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Driver Dashboard</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #f3f3f3;
            display: flex;
            height: 100vh;
        }

        /* SIDEBAR */

        .sidebar {
            width: 240px;
            background: #1c1c1c;
            color: white;
            display: flex;
            flex-direction: column;
            padding: 30px 20px;
        }

        .logo {
            font-family: 'Poppins', sans-serif;
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 40px;
        }

        .menu {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

            .menu a {
                text-decoration: none;
                color: #cfcfcf;
                font-size: 15px;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px;
                border-radius: 6px;
                transition: 0.2s;
            }

                .menu a:hover {
                    background: #2a2a2a;
                    color: #E8571A;
                }

        .bottom-menu {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* MAIN */

        .main {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        /* HEADER */

        .header {
            height: 70px;
            background: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            border-bottom: 1px solid #e5e5e5;
        }

        .search {
            background: #f1f1f1;
            padding: 8px 15px;
            border-radius: 20px;
            border: none;
            width: 250px;
        }

        .profile {
            font-size: 14px;
            color: #333;
        }

        /* DASHBOARD */

        .dashboard {
            padding: 30px;
            display: grid;
            grid-template-columns: 350px 1fr;
            gap: 25px;
        }

        /* DELIVERY CARD */

        .delivery-card {
            background: white;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .delivery-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
        }

        .status {
            background: #e6e6e6;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
        }

            .status.intransit {
                background: #ffe2d8;
                color: #E8571A;
            }

            .status.delivered {
                background: #e2f6e7;
                color: #2f9e44;
            }

        /* RIGHT PANEL */

        .right-panel {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        /* MAP */

        .map-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            height: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #999;
            font-size: 18px;
        }

        /* TRUCK INFO PANEL */

        .info-card {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        /* TABS */

        .tabs {
            display: flex;
            gap: 30px;
            margin-bottom: 20px;
            border-bottom: 1px solid #eee;
            padding-bottom: 10px;
        }

        .tab {
            font-weight: 500;
            color: #777;
            cursor: pointer;
        }

            .tab.active {
                color: #000;
                border-bottom: 3px solid #E8571A;
                padding-bottom: 8px;
            }

        /* VEHICLE INFO */

        .vehicle {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .truck-img {
            width: 120px;
            height: auto;
        }

        .vehicle-details {
            display: grid;
            grid-template-columns: repeat(2,150px);
            gap: 10px 30px;
        }

            .vehicle-details div {
                font-size: 14px;
                color: #555;
            }

            .vehicle-details strong {
                display: block;
                font-size: 15px;
                color: #000;
            }

        .rating {
            font-size: 16px;
            color: #f59f00;
        }

    </style>

</head>

<body>

    <!-- SIDEBAR -->

    <div class="sidebar">

        <div class="logo">Driver Dashboard</div>

        <div class="menu">

            <a href="#">Delivery Status</a>
            <a href="#">Request Delivery Report</a>
            <a href="#">Request Delivery Report</a>

        </div>

        <div class="bottom-menu">

            <a href="#">❓ Help</a>
            <a href="#">⚙ Settings</a>
            <a asp-action="Logout" asp-controller="DriverDashboard">↩ Log out</a>

        </div>

    </div>

    <!-- MAIN -->

    <div class="main">

        <div class="header">

            <input class="search" placeholder="Search for a delivery">

            <div class="profile">Jane Doe</div>

        </div>


        <div class="dashboard">

            <!-- LEFT COLUMN -->

            <div>

                <!-- CARD 1 -->
                <div class="delivery-card">
                    <div class="delivery-header">
                        <strong>Delivery ID: #DR2435</strong>
                        <span class="status intransit">In Transit</span>
                    </div>
                    <p>27/1/26 — Checking</p>
                    <p>29/1/26 — In Transit</p>
                </div>

                <!-- CARD 2 -->
                <div class="delivery-card">
                    <div class="delivery-header">
                        <strong>Delivery ID: #DR9835</strong>
                        <span class="status delivered">Delivered</span>
                    </div>
                    <p>27/1/26 — Checking</p>
                    <p>29/1/26 — In Transit</p>
                    <p>3/3/26 — Delivered</p>
                </div>

                <!-- CARD 3 -->
                <div class="delivery-card">
                    <div class="delivery-header">
                        <strong>Delivery ID: #DR6254</strong>
                        <span class="status intransit">In Transit</span>
                    </div>
                    <p>02/2/26 — Checking</p>
                    <p>03/2/26 — Loading Cargo</p>
                    <p>04/2/26 — In Transit</p>
                </div>

                <!-- CARD 4 -->
                <div class="delivery-card">
                    <div class="delivery-header">
                        <strong>Delivery ID: #DR8121</strong>
                        <span class="status delivered">Delivered</span>
                    </div>
                    <p>15/1/26 — Checking</p>
                    <p>17/1/26 — In Transit</p>
                    <p>19/1/26 — Delivered</p>
                </div>

            </div>

            <!-- RIGHT COLUMN -->

            <div class="right-panel">

                <!-- MAP AREA -->

                <div class="map-card">
                    Live GPS Tracking Map
                </div>

                <!-- TRUCK INFO -->

                <div class="info-card">

                    <div class="tabs">
                        <div class="tab">Driver Information</div>
                        <div class="tab active">Vehicle</div>
                        <div class="tab">Customer Information</div>
                    </div>

                    <div class="vehicle">

                        <img class="truck-img" src="https://d2e5b8shawuel2.cloudfront.net/vehicle/286781/hlv/original.jpg">

                        <div>

                            <strong>Mercedes-Benz</strong>

                            <div class="rating">⭐ 4.9</div>

                            <br>

                            <div class="vehicle-details">

                                <div>
                                    <strong>Model</strong>
                                    Actros 1845
                                </div>

                                <div>
                                    <strong>Capacity</strong>
                                    70%
                                </div>

                                <div>
                                    <strong>Weight</strong>
                                    1250kg
                                </div>

                                <div>
                                    <strong>Load Volume</strong>
                                    775 Litres
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</body>

</html>