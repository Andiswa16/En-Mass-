@model List<EnMasse.Models.Delivery>
@{
    ViewData["Title"] = "Customer Dashboard";
    Layout = "_Layout";
}

<div style="padding:20px;">

    <!-- Top bar -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
        <div style="display:flex; align-items:center; gap:16px;">
            <div style="background:white; border-radius:50%; width:56px; height:56px; display:flex; flex-direction:column; align-items:center; justify-content:center; border:1px solid #ddd; font-weight:700; font-size:18px;">
                @DateTime.Now.Day
                <span style="font-size:10px; font-weight:400; color:#666;">@DateTime.Now.ToString("ddd MMM")</span>
            </div>
            <div style="background:white; border-radius:30px; border:1px solid #333; padding:10px 20px; display:flex; align-items:center; gap:8px; min-width:280px;">
                <span>&#128269;</span>
                <input type="text" placeholder="Search for a delivery" style="border:none; outline:none; font-size:14px; width:100%;" />
            </div>
        </div>
        <div style="background:white; border-radius:30px; border:1px solid #ddd; padding:10px 20px; display:flex; align-items:center; gap:10px;">
            <span style="font-size:24px;">&#128100;</span>
            <span style="font-weight:600;">@HttpContext.Session.GetString("Username")</span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background:#d4edda; color:#155724; padding:12px; border-radius:8px; margin-bottom:16px;">@TempData["Success"]</div>
    }

    <!-- Cards row -->
    <div style="display:flex; gap:20px; margin-bottom:24px;">

        <!-- Latest delivery card -->
        @if (Model.Any())
        {
            var latest = Model.First();
            <div style="flex:1.5; background:#888; color:white; border-radius:16px; padding:24px; position:relative; overflow:hidden;">
                <span style="font-size:80px; position:absolute; right:-10px; bottom:-20px; opacity:0.15;">&#128666;</span>
                <p style="margin:0 0 8px; font-weight:600;">Delivery ID: #DR@latest.DeliveryID</p>
                <span style="background:white; color:#333; border-radius:30px; padding:4px 14px; font-size:13px; font-weight:600; float:right; margin-top:-28px;">@latest.Status</span>
                <div style="margin-top:16px;">
                    <p style="margin:6px 0; font-size:14px;">@latest.CreatedDate.ToString("d/M/yy") &nbsp; Checking</p>
                    <p style="margin:6px 0; font-size:14px;">@latest.DeliveryDate.ToString("d/M/yy") &nbsp; @latest.Status</p>
                </div>
            </div>
        }
        else
        {
            <div style="flex:1.5; background:#888; color:white; border-radius:16px; padding:24px;">
                <p>No deliveries yet.</p>
                <a asp-action="RequestDelivery" style="color:white; font-weight:700;">Request your first delivery →</a>
            </div>
        }

        <!-- Donut chart card -->
        <div style="flex:1; background:white; border-radius:16px; padding:24px; text-align:center; border:1px solid #eee;">
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:16px;">
                <span style="width:10px; height:10px; background:#e05a2b; border-radius:50%; display:inline-block;"></span>
                <span style="font-weight:700;">Delivery Status</span>
            </div>
            @{
                int total = Model.Count;
                int delivered = Model.Count(d => d.Status == "Delivered");
                int pct = total > 0 ? (delivered * 100 / total) : 0;
                int dash = (int)(pct * 2.51);
                int gap = 251 - dash;
            }
            <svg viewBox="0 0 100 100" width="120" height="120">
                <circle cx="50" cy="50" r="40" fill="none" stroke="#f0f0f0" stroke-width="12" />
                <circle cx="50" cy="50" r="40" fill="none" stroke="#e05a2b" stroke-width="12"
                        stroke-dasharray="@dash @gap" stroke-linecap="round"
                        transform="rotate(-90 50 50)" />
                <text x="50" y="47" text-anchor="middle" font-size="14" font-weight="700">@pct%</text>
                <text x="50" y="60" text-anchor="middle" font-size="7" fill="#999">Within Time Limit</text>
            </svg>
        </div>
    </div>

    <!-- Deliveries table -->
    <div style="background:white; border-radius:16px; padding:24px; border:1px solid #eee;">
        <table style="width:100%; border-collapse:collapse; font-size:14px;">
            <thead>
                <tr style="border-bottom:2px solid #f0f0f0;">
                    <th style="text-align:left; padding:10px;">Delivery ID</th>
                    <th style="text-align:left; padding:10px;">Arrival Date</th>
                    <th style="text-align:left; padding:10px;">Route</th>
                    <th style="text-align:left; padding:10px;">Weight</th>
                    <th style="text-align:left; padding:10px;">Delivery Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr style="border-bottom:1px solid #f5f5f5;">
                        <td style="padding:12px 10px; font-weight:700;">@d.DeliveryID</td>
                        <td style="padding:12px 10px;">@d.DeliveryDate.ToString("d/M/yy")</td>
                        <td style="padding:12px 10px;">@d.PickupAddress – @d.DeliveryAddress</td>
                        <td style="padding:12px 10px;">@d.Weight</td>
                        <td style="padding:12px 10px; font-weight:700;">@d.Status</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" style="padding:20px; text-align:center; color:#999;">No deliveries found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>