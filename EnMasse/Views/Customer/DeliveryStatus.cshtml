@model List<EnMasse.Models.Delivery>
@{
    ViewData["Title"] = "Delivery Status";
    Layout = "_Layout";
}

<div style="padding:20px;">
    <h2 style="font-weight:700; margin-bottom:24px;">Delivery Status</h2>

    <div style="background:white; border-radius:16px; padding:24px; border:1px solid #eee;">
        <table style="width:100%; border-collapse:collapse; font-size:14px;">
            <thead>
                <tr style="border-bottom:2px solid #f0f0f0;">
                    <th style="text-align:left; padding:10px;">Delivery ID</th>
                    <th style="text-align:left; padding:10px;">Route</th>
                    <th style="text-align:left; padding:10px;">Weight</th>
                    <th style="text-align:left; padding:10px;">Delivery Date</th>
                    <th style="text-align:left; padding:10px;">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    var statusColor = d.Status switch
                    {
                        "Delivered" => "#155724",
                        "In Transit" => "#856404",
                        "Pending" => "#666",
                        _ => "#333"
                    };
                    var bgColor = d.Status switch
                    {
                        "Delivered" => "#d4edda",
                        "In Transit" => "#fff3cd",
                        "Pending" => "#f8f9fa",
                        _ => "white"
                    };
                    <tr style="border-bottom:1px solid #f5f5f5;">
                        <td style="padding:12px 10px; font-weight:700;">#DR@d.DeliveryID</td>
                        <td style="padding:12px 10px;">@d.PickupAddress – @d.DeliveryAddress</td>
                        <td style="padding:12px 10px;">@d.Weight</td>
                        <td style="padding:12px 10px;">@d.DeliveryDate.ToString("d/M/yy")</td>
                        <td style="padding:12px 10px;">
                            <span style="background:@bgColor; color:@statusColor; padding:4px 12px; border-radius:30px; font-weight:600; font-size:13px;">
                                @d.Status
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" style="padding:20px; text-align:center; color:#999;">No deliveries found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>