@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div style="display:flex; justify-content:center; align-items:center; min-height:100vh; background:#f0f0f0;">
    <div style="background:white; padding:50px 60px; border-radius:12px; width:100%; max-width:520px; text-align:center;">

        <h1 style="font-size:28px; font-weight:900; margin-bottom:24px;">
            EN MASSE'<span style="color:#e05a2b;">LOGISTICS</span>
        </h1>
        <h2 style="font-size:20px; font-weight:700; margin-bottom:4px;">Welcome</h2>
        <p style="color:#666; margin-bottom:24px;">Please fill in your details</p>

        @if (TempData["Success"] != null)
        {
            <div style="background:#d4edda; color:#155724; padding:12px; border-radius:8px; margin-bottom:16px;">
                @TempData["Success"]
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div style="background:#f8d7da; color:#721c24; padding:12px; border-radius:8px; margin-bottom:16px;">
                @ViewBag.Error
            </div>
        }

        <form method="post" asp-action="Login" asp-controller="Auth">
            <input type="text" name="username" placeholder="Please enter your username"
                   style="width:100%; padding:14px 20px; border-radius:30px; border:none; background:#e05a2b; color:white; font-size:15px; margin-bottom:14px; outline:none; box-sizing:border-box;" />

            <input type="password" name="password" placeholder="Please enter your password"
                   style="width:100%; padding:14px 20px; border-radius:30px; border:none; background:#e05a2b; color:white; font-size:15px; margin-bottom:10px; outline:none; box-sizing:border-box;" />

            <div style="text-align:right; margin-bottom:20px;">
                <a href="#" style="color:#333; font-size:14px;">Forgot Password?</a>
            </div>

            <button type="submit"
                    style="width:100%; padding:14px; border-radius:30px; border:2px solid #333; background:transparent; font-size:15px; font-weight:700; cursor:pointer; margin-bottom:16px;">
                Login
            </button>
        </form>

        <p style="color:#666; font-size:14px; margin-bottom:8px;">Don't have an account?</p>
        <a asp-controller="Auth" asp-action="Register"
               style="font-weight:700; font-size:15px; text-decoration:underline; color:#000; display:block; margin-bottom:20px;">
            Register here
        </a>

        <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
            <hr style="flex:1; border:none; border-top:1px solid #ccc;" />
            <span style="color:#666; font-size:14px;">Sign in with</span>
            <hr style="flex:1; border:none; border-top:1px solid #ccc;" />
        </div>

        <div style="display:flex; justify-content:center; gap:16px;">
            <a href="#"><img src="https://upload.wikimedia.org/wikipedia/commons/5/51/Facebook_f_logo_%282019%29.svg" style="width:40px; height:40px;" /></a>
            <a href="#"><img src="https://upload.wikimedia.org/wikipedia/commons/2/2f/Google_2015_logo.svg" style="width:40px; height:40px;" /></a>
            <a href="#" style="font-size:28px; text-decoration:none; color:#555;">&#63743;</a>
        </div>
    </div>
</div>